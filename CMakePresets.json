{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-avx2",
      "displayName": "Native release (AVX2/FMA)",
      "description": "Release build of the native UHD/C++ chain with the AVX2/FMA DSP kernels and the UHD backend auto-detected.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX2",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "ON",
        "UWB_DEV_SCOPE": "all"
      }
    },
    {
      "name": "native-avx512",
      "displayName": "Native release (AVX-512)",
      "description": "Release build enabling the AVX-512 DSP kernel translation unit on an AVX2/FMA baseline, with the UHD backend auto-detected.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX512",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "ON",
        "UWB_DEV_SCOPE": "all"
      }
    },
    {
      "name": "scalar-debug",
      "displayName": "Scalar debug",
      "description": "Debug build with the self-written SIMD kernels disabled, for reference/step-through QA.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UWB_SIMD": "SCALAR",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "ON",
        "UWB_DEV_SCOPE": "all"
      }
    },
    {
      "name": "no-uhd",
      "displayName": "Native release (no UHD)",
      "description": "Release build with the UHD device backends disabled; the replay/library/QA chain still builds and tests.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AUTO",
        "ENABLE_UHD_BACKEND": "OFF",
        "UWB_BUILD_EXPERIMENTS": "ON",
        "UWB_DEV_SCOPE": "all"
      }
    },
    {
      "name": "dev-avx2",
      "displayName": "Daily dev (Ninja, AVX2, experiments off)",
      "description": "Ninja + Release + AVX2/FMA, UHD backend auto-detected, experiments OFF: the everyday build+test loop.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX2",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "OFF",
        "UWB_DEV_SCOPE": "all"
      }
    },
    {
      "name": "dev-rx",
      "displayName": "Dev RX only (scope=rx, shared libs)",
      "description": "Single-domain RX/SIC shared-lib build: support+dsp+phy_hrp+sic+radio+runtime, RX apps, rx_sic/dsp_extra QA. Shared domain libraries are the default; install rules disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX2",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "OFF",
        "UWB_DEV_SCOPE": "rx",
        "UWB_DEV_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "dev-tx",
      "displayName": "Dev TX only (scope=tx, shared libs)",
      "description": "Single-domain TX shared-lib build: support+dsp+phy_hrp modulator core, HRP modulator QA and benchmark. Shared domain libraries are the default; install rules disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX2",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "OFF",
        "UWB_DEV_SCOPE": "tx",
        "UWB_DEV_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "dev-twr",
      "displayName": "Dev TWR only (scope=twr, shared libs)",
      "description": "Single-domain TWR shared-lib build: support+dsp+phy_hrp+twr_core/fake_link/phy, the two TWR demos and all TWR QA. Shared domain libraries are the default; install rules disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX2",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "OFF",
        "UWB_DEV_SCOPE": "twr",
        "UWB_DEV_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "dev-radar",
      "displayName": "Dev radar only (scope=radar, shared libs)",
      "description": "Single-domain radar shared-lib build: support+dsp+phy_hrp+sensing+sic+radio+runtime, pipeline runner, sensing/radio QA. Shared domain libraries are the default; install rules disabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "UWB_SIMD": "AVX2",
        "ENABLE_UHD_BACKEND": "AUTO",
        "UWB_BUILD_EXPERIMENTS": "OFF",
        "UWB_DEV_SCOPE": "radar",
        "UWB_DEV_SHARED_LIBS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-avx2",
      "configurePreset": "native-avx2"
    },
    {
      "name": "native-avx512",
      "configurePreset": "native-avx512"
    },
    {
      "name": "scalar-debug",
      "configurePreset": "scalar-debug"
    },
    {
      "name": "no-uhd",
      "configurePreset": "no-uhd"
    },
    {
      "name": "dev-avx2",
      "configurePreset": "dev-avx2"
    },
    {
      "name": "dev-rx",
      "configurePreset": "dev-rx"
    },
    {
      "name": "dev-tx",
      "configurePreset": "dev-tx"
    },
    {
      "name": "dev-twr",
      "configurePreset": "dev-twr"
    },
    {
      "name": "dev-radar",
      "configurePreset": "dev-radar"
    }
  ],
  "testPresets": [
    {
      "name": "native-avx2",
      "configurePreset": "native-avx2",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-avx512",
      "configurePreset": "native-avx512",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "scalar-debug",
      "configurePreset": "scalar-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "no-uhd",
      "configurePreset": "no-uhd",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-avx2",
      "configurePreset": "dev-avx2",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-rx",
      "configurePreset": "dev-rx",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-tx",
      "configurePreset": "dev-tx",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-twr",
      "configurePreset": "dev-twr",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-radar",
      "configurePreset": "dev-radar",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
